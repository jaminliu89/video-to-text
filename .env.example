# VideoToText 配置模板
# 复制为 .env 后填入你的配置
# GUI 里也可以直接配置（设置页），优先级高于 .env

# ===== 转写引擎 =====
# 跑 `python3 cli.py engines` 看这台机器上哪些引擎真能用
#
# faster-whisper（CPU 通用，默认）
# WHISPER_MODEL=base
#
# mlx-whisper（Apple Silicon Metal，同质量快 7 倍；仅 macOS arm64）
# pip install mlx-whisper
# MLX_WHISPER_MODEL=large-v3-turbo
#
# Qwen3-ASR（中文最准）
#   本地：pip install qwen-asr，模型 0.6b / 1.7b（需下载 1.2G / 3.5G）
#   云端：配 DASHSCOPE_API_KEY，模型填 flash（零下载，按量计费）
# QWEN3_ASR_MODEL=0.6b
# QWEN3_ASR_ALIGN=0            # 1 = 加载强制对齐模型拿字级时间戳（多 1.2G）
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# whisper.cpp（旧本地模式）
# WHISPER_CLI=whisper-cli
# WHISPER_MODEL_DIR=~/.cache/whisper

# ===== 硅基流动（关键帧 VLM + LLM 摘要）=====
# SILICONFLOW_API_KEY=your_key_here
# SILICONFLOW_BASE=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# VLM_MODEL=Qwen/Qwen3-VL-32B-Instruct

# ===== 火山方舟（豆包视频理解）=====
# ARK_API_KEY=ark-your_key_here
# ARK_VIDEO_ENDPOINT=ep-xxxxxx
# ARK_BASE=https://ark.cn-beijing.volces.com/api/v3

# ===== 蒸馏模式（第三模式）用的 LLM =====
# 任意 OpenAI 兼容端点都行（Gemini / DeepSeek / 本地 vLLM / one-api）
# 留空则自动回落：硅基流动 → 火山方舟
# DISTILL_LLM_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# DISTILL_LLM_KEY=your_key_here
# DISTILL_LLM_MODEL=gemini-2.5-flash
# 思维链：auto=抽取类关、抽象类开（默认）｜ off=全关，快 3-5 倍 ｜ on=全开，质量更好
# DISTILL_THINKING=auto

# ===== Obsidian =====
# OBSIDIAN_VAULT=~/Documents/Obsidian Vault
# OBSIDIAN_FOLDER=01_内容创作/视频笔记

# ===== 路径 =====
# CACHE_DIR=./cache
# OUTPUT_DIR=./output
